# Copy to .env and fill in real values. Never commit .env.

# Postgres connection string (Neon, Supabase, RDS, or local Docker postgres all work)
DATABASE_URL=postgres://outbid:outbid@localhost:5432/outbid_city

# Stripe (test mode keys while building)
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_SUCCESS_URL=https://outbidcity.lol/checkout/success?session_id={CHECKOUT_SESSION_ID}
STRIPE_CANCEL_URL=https://outbidcity.lol/checkout/cancel

# App
PORT=8787
CORS_ORIGIN=https://outbidcity.lol,http://localhost:5173

# Business rules (mirrors src/lib/constants.ts on the client)
FLOOR_CENTS=100
TAKE_DELTA_CENTS=100

# Security / abuse controls (see backend/SECURITY.md)
RATE_LIMIT_MAX=20
RATE_LIMIT_WINDOW_MS=60000
BODY_LIMIT_BYTES=262144
MAX_BID_CENTS=10000000

# Read-only snapshot routes get their own, larger budget. They are cheap and cached, but the SEO
# edge functions call them 2-3x per rendered page and crawlers arrive from a few shared IPs — under
# the write budget a crawler throttles itself within a handful of pages. See SECURITY.md Threat 8.
READ_RATE_LIMIT_MAX=300
READ_RATE_LIMIT_WINDOW_MS=60000

# Analytics writes are high-frequency by design (a player passes many surfaces) and must not share
# the checkout budget, or normal play would throttle purchases.
ANALYTICS_RATE_LIMIT_MAX=120
ANALYTICS_RATE_LIMIT_WINDOW_MS=60000
# Hard cap on placements accepted in one /analytics/passes batch.
ANALYTICS_MAX_BATCH=24

# REQUIRED IN PRODUCTION. Salt for the server-derived analytics visitor hash (SECURITY.md Threat
# 14). Without it the salt is random per process, so impression/click dedup resets on every cold
# start and each running instance counts the same visitor again — i.e. inflated numbers, which is
# the exact bug the hash exists to prevent. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ANALYTICS_SALT=

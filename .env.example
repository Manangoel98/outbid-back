# Copy to .env and fill in real values. Never commit .env.

# Postgres connection string (Neon, Supabase, RDS, or local Docker postgres all work)
DATABASE_URL=postgres://outbid:outbid@localhost:5432/outbid_city

# Stripe (test mode keys while building)
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_SUCCESS_URL=https://outbidcity.lol/checkout/success?session_id={CHECKOUT_SESSION_ID}
STRIPE_CANCEL_URL=https://outbidcity.lol/checkout/cancel

# App
PORT=8787
CORS_ORIGIN=https://outbidcity.lol,http://localhost:5173

# Business rules (mirrors src/lib/constants.ts on the client)
FLOOR_CENTS=100
TAKE_DELTA_CENTS=100

# Security / abuse controls (see backend/SECURITY.md)
RATE_LIMIT_MAX=20
RATE_LIMIT_WINDOW_MS=60000
BODY_LIMIT_BYTES=262144
MAX_BID_CENTS=10000000
